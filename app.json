{
  "expo": {
    "name": "segundo_semestre",
    "slug": "segundo_semestre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoTech.png",
    "scheme": "projetosecretaria",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logoTech.png",
        "monochromeImage": "./assets/images/logoTech.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logoTech.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoTech.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
